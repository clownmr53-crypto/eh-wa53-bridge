# Copier vers .env sur le VPS le matin du déploiement. Ne jamais commiter .env.
# Aucune valeur réelle dans ce fichier : que des emplacements vides.
EH_LINE=53
EH_INSTANCE=eh-wa53-vps1
DATA_DIR=
PORT=
BRIDGE_KEY=
# Optionnel : republication d'affichage QR (UNIQUEMENT pour afficher le QR,
# JAMAIS pour stocker ou restaurer une authentification).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Cerveau de réponse (même logique que la ligne 59, sans ses identifiants) :
# GROQ_API_KEY, puis GEMINI_API_KEY en repli. Laisser vide = réponses
# d'accueil + accusé de réception uniquement, jamais de réponse inventée.
GROQ_API_KEY=
GEMINI_API_KEY=
# Numéro 53 au format international sans +, utilisé UNIQUEMENT pour le mode
# code d'appairage si Horeb choisit le code au lieu du QR. Ne pas le coder
# en dur ailleurs dans le code.
PAIR_PHONE=
